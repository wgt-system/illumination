<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="using:Illumination.Desktop"
        xmlns:content="using:Illumination.Application.ContentManagement"
        x:Class="Illumination.Desktop.MainWindow"
        x:DataType="desktop:MainWindowViewModel"
        Title="Illumination"
        Width="1120" Height="740" MinWidth="920" MinHeight="620">
  <Window.Styles>
    <Style Selector="TabControl.shell-navigation">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.shell-navigation TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLowBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="MinWidth" Value="156" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.grade">
      <Setter Property="MinWidth" Value="116" />
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.68" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="46,*,Auto" Margin="12">
    <Border BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="8,0">
      <TextBlock Text="Illumination" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Border>

    <TabControl Classes="shell-navigation" Grid.Row="1" TabStripPlacement="Left" Margin="0,10,0,8">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M3,5 L9,5 11,7 21,7 21,19 3,19 Z" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.5" Width="18" Height="18" />
            <TextBlock Text="Decks" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Grid ColumnDefinitions="280,*" ColumnSpacing="20" Margin="12">
          <StackPanel Spacing="10">
            <TextBlock Text="Decks" FontSize="20" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding DeckPresentationItems}" SelectedItem="{Binding SelectedDeckPresentation}" MinHeight="300">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="desktop:DeckPresentationItem">
                  <StackPanel Margin="6">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LearningItemCount, StringFormat='{}{0} item(s)'}" Opacity="0.65" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Create Deck" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox Text="{Binding NewDeckName}" Watermark="Deck name" />
            <Button Content="Create Deck" Command="{Binding CreateDeckCommand}" HorizontalAlignment="Left" />
          </StackPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,*" RowSpacing="8">
            <TextBlock Text="Learning Items in selected Deck" FontSize="18" FontWeight="SemiBold" />
            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedDeckItems}" SelectedItem="{Binding SelectedDeckItem}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="content:LearningItemView">
                  <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="6" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
              <Button Content="Remove selected" Command="{Binding RemoveFromDeckCommand}" />
              <TextBlock Text="Available Learning Items" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <ListBox ItemsSource="{Binding AvailableDeckItems}" SelectedItem="{Binding SelectedAvailableDeckItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="content:LearningItemView">
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="6" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Column="1" Content="Add selected" Command="{Binding AddToDeckCommand}" VerticalAlignment="Top" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M5,3 L18,3 21,6 21,21 5,21 Z M18,3 L18,7 21,7 M8,11 L18,11 M8,15 L18,15" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.5" Width="18" Height="18" />
            <TextBlock Text="Learning Items" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Grid ColumnDefinitions="*,360" ColumnSpacing="24" Margin="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Learning Items" FontSize="20" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding ContentCuration.FilteredItems}" SelectedItem="{Binding ContentCuration.SelectedItem}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="desktop:CuratedLearningItemRowViewModel">
                  <Grid ColumnDefinitions="34,*,Auto" Margin="6" ColumnSpacing="7">
                    <CheckBox IsChecked="{Binding IsSelectedForReview}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding Prompt}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding QualityState}" Foreground="#B77900" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ContentRevision, StringFormat='rev {0}'}" Classes="secondary" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Content="Select all for review" Command="{Binding ContentCuration.SelectAllReviewItemsCommand}" />
              <Button Content="Clear review selection" Command="{Binding ContentCuration.ClearReviewItemSelectionCommand}" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding ContentCuration.FlagDefinitions}" SelectedItem="{Binding ContentCuration.FilterFlag}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="content:UserFlagDefinitionView"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Create SelfAssessed Learning Item" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Prompt" />
              <TextBox Text="{Binding NewPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
              <TextBlock Text="Reference Solution" />
              <TextBox Text="{Binding NewReferenceSolution}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
              <Button Content="Create Learning Item" Command="{Binding CreateLearningItemCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Selected item quality" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ContentCuration.SelectedItem.QualityState, FallbackValue='Select an item'}" />
              <TextBlock Text="{Binding ContentCuration.SelectedItem.ContentRevision, StringFormat='ContentRevision: {0}'}" Classes="secondary" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ComboBox Width="180" ItemsSource="{Binding ContentCuration.FlagDefinitions}" SelectedItem="{Binding ContentCuration.SelectedFlag}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="content:UserFlagDefinitionView"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Add flag" Command="{Binding ContentCuration.AddFlagCommand}" />
                <Button Content="Remove flag" Command="{Binding ContentCuration.RemoveFlagCommand}" />
              </StackPanel>
              <TextBlock Text="New flag name" Classes="secondary" />
              <TextBox Text="{Binding ContentCuration.NewFlagName}" Watermark="Name" />
              <TextBox Text="{Binding ContentCuration.NewFlagMeaning}" Watermark="User-defined meaning" />
              <Button Content="Create flag" Command="{Binding ContentCuration.CreateFlagCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Review history" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding ContentCuration.SelectedItem.History}" MaxHeight="140">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="desktop:QualityReviewHistoryRowViewModel">
                    <StackPanel Margin="2,3" Spacing="2">
                      <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="Active" IsVisible="{Binding IsActive}" Classes="secondary" />
                      <TextBlock Text="Superseded historical review" IsVisible="{Binding !IsActive}" Classes="secondary" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Review exchange" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ComboBox Width="150" ItemsSource="{Binding ContentCuration.ReviewModes}" SelectedItem="{Binding ContentCuration.ReviewMode}" />
                <Button Content="Generate prompt" Command="{Binding ContentCuration.GenerateReviewPromptCommand}" />
                <Button Content="Copy prompt" Command="{Binding ContentCuration.CopyReviewPromptCommand}" />
              </StackPanel>
              <TextBox Text="{Binding ContentCuration.ReviewPrompt}" IsReadOnly="True" AcceptsReturn="True" Height="120" IsVisible="{Binding ContentCuration.HasReviewPrompt}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <TextBox Text="{Binding ContentCuration.RawReviewJson}" AcceptsReturn="True" Height="130" Watermark="Paste Quality Review Result JSON" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Content="Load result" Command="{Binding ContentCuration.LoadReviewFileCommand}" />
                <Button Content="Preview result" Command="{Binding ContentCuration.PreviewReviewResultsCommand}" />
                <Button Content="Accept selected reviews" Command="{Binding ContentCuration.AcceptSelectedReviewsCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding ContentCuration.ReviewSummary}" IsVisible="{Binding ContentCuration.HasReviewPreview}" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding ContentCuration.ReviewResults}" Height="190" IsVisible="{Binding ContentCuration.HasReviewPreview}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="desktop:QualityReviewExchangeRowViewModel">
                    <StackPanel Margin="2,3" Spacing="2">
                      <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" Content="{Binding Outcome}" />
                      <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding SuggestedCorrection, StringFormat='Suggested correction: {0}'}" IsVisible="{Binding HasSuggestedCorrection}" Foreground="#B77900" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" Foreground="#D14B42" TextWrapping="Wrap" FontSize="12" />
                      <ItemsControl ItemsSource="{Binding PriorActiveReviews}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="desktop:QualityReviewHistoryRowViewModel"><CheckBox Content="{Binding Findings, StringFormat='Supersede: {0}'}" Command="{Binding $parent[ItemsControl].DataContext.ToggleSupersededCommand}" CommandParameter="{Binding Id}" /></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem IsSelected="True">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M4,12 L20,4 16,20 12,14 Z" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.5" Width="18" Height="18" />
            <TextBlock Text="Study" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="14,4,4,4">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,280,Auto,Auto,*,Auto" ColumnSpacing="8" RowSpacing="6">
            <TextBlock Text="Deck" VerticalAlignment="Center" Classes="secondary" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding DeckPresentationItems}" SelectedItem="{Binding SelectedStudyDeckPresentation}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="desktop:DeckPresentationItem"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="Start" Command="{Binding StartSessionCommand}" />
            <Button Grid.Column="3" Content="Complete" Command="{Binding CompleteSessionCommand}" />
            <TextBlock Grid.Column="5" Text="{Binding RemainingQueueEntryCount, StringFormat='{}{0} remaining'}" VerticalAlignment="Center" Classes="secondary" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Evaluation" VerticalAlignment="Center" Classes="secondary" />
              <ComboBox ItemsSource="{Binding EvaluationModeOptions}" SelectedItem="{Binding SelectedEvaluationModeOption}" Width="170">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="desktop:StudyEvaluationModeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Global default" VerticalAlignment="Center" Classes="secondary" />
              <ComboBox ItemsSource="{Binding EvaluationModes}" SelectedItem="{Binding GlobalEvaluationMode}" Width="110" />
              <CheckBox Content="Consider assistance" IsChecked="{Binding ConsiderAssistance}" />
              <CheckBox Content="Low-interaction only" IsChecked="{Binding LowInteractionOnly}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,240" ColumnSpacing="12">
            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="7" Padding="20,16">
              <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Current card" Classes="secondary" />
                  <Border Grid.Column="1" IsVisible="{Binding CurrentItemRequiresReinforcement}" Background="#35C87900" CornerRadius="10" Padding="8,3">
                    <TextBlock Text="Reinforcement" FontSize="11" />
                  </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="16" Margin="10,8">
                    <TextBlock Text="{Binding CurrentStudyItem.Prompt, FallbackValue='Select a Deck and start a session.'}"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="27" FontWeight="SemiBold" />
                    <ItemsControl IsVisible="{Binding IsSelectionMode}" ItemsSource="{Binding CurrentDirectChoices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="desktop:StudyChoiceDisplay"><CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected}" Margin="12,2" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox IsVisible="{Binding IsShortTextMode}" Text="{Binding ShortTextResponse}" Watermark="Short response" />
                    <TextBox IsVisible="{Binding IsCodeMode}" Text="{Binding CodeResponse}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="110" Watermark="Code response (not executed)" />
                    <Button IsVisible="{Binding IsSelectionMode}" Content="Submit choices" Command="{Binding SubmitResponseCommand}" HorizontalAlignment="Center" />
                    <Button IsVisible="{Binding IsShortTextMode}" Content="Submit response" Command="{Binding SubmitResponseCommand}" HorizontalAlignment="Center" />
                    <Button IsVisible="{Binding IsCodeMode}" Content="Submit code response" Command="{Binding SubmitResponseCommand}" HorizontalAlignment="Center" />
                    <StackPanel IsVisible="{Binding IsSelfAssessedMode}" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                      <Button Content="Reveal next hint" Command="{Binding RevealHintCommand}" />
                      <Button Content="Reveal assistance choices" Command="{Binding RevealAssistanceCommand}" />
                    </StackPanel>
                    <ItemsControl IsVisible="{Binding AssistanceAnswerChoicesRevealed}" ItemsSource="{Binding CurrentAssistanceChoices}">
                      <ItemsControl.ItemTemplate><DataTemplate x:DataType="desktop:StudyChoiceDisplay"><TextBlock Text="{Binding Text}" Classes="secondary" Margin="12,1" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding HasCurrentStudyItem}" ItemsSource="{Binding RevealedHints}">
                      <ItemsControl.ItemTemplate><DataTemplate><Border Background="#12000000" Padding="8" Margin="4"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Show solution" Command="{Binding RevealSolutionCommand}" HorizontalAlignment="Center" />
                    <StackPanel IsVisible="{Binding HasAutomaticResult}" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                      <TextBlock Text="Automatic result:" Classes="secondary" />
                      <TextBlock Text="{Binding AutomaticCorrectness}" FontWeight="SemiBold" />
                      <TextBlock Text="Suggested grade:" Classes="secondary" />
                      <TextBlock Text="{Binding SuggestedAssessment}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border IsVisible="{Binding IsSolutionRevealed}" Background="#16000000" CornerRadius="5" Padding="16">
                      <StackPanel Spacing="5">
                        <TextBlock Text="Solution" Classes="secondary" />
                        <TextBlock Text="{Binding CurrentStudyItem.ReferenceSolution}" TextWrapping="Wrap" FontSize="17" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding AssessmentPreviews}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="desktop:StudyAssessmentPreviewDisplay">
                      <Button Classes="grade" Command="{Binding Command}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding Projection}" Classes="secondary" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="3" Text="Complete may be used at any time; reinforcement remains available in a later session." Classes="secondary" HorizontalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#22000000" BorderThickness="1" CornerRadius="7" Padding="12">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <TextBlock Text="Upcoming" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Next five queue entries" Classes="secondary" />
                <ListBox Grid.Row="2" ItemsSource="{Binding UpcomingStudyItems}" IsHitTestVisible="False">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="desktop:StudyQueueEntryDisplay">
                      <StackPanel Margin="3,5" Spacing="3">
                        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{Binding StateLabel}" Classes="secondary" FontWeight="SemiBold" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,0,0,8" VerticalAlignment="Bottom" Spacing="4">
                  <TextBlock Text="Current item flags" Classes="secondary" />
                  <ItemsControl ItemsSource="{Binding ContentCuration.StudyFlags}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="content:UserFlagDefinitionView">
                        <Button Content="{Binding Name}" Command="{Binding $parent[ItemsControl].DataContext.ToggleStudyFlagCommand}" CommandParameter="{Binding Id}" HorizontalAlignment="Left" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M12,3 L12,15 M7,10 L12,15 17,10 M4,18 L4,21 20,21 20,18" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.5" Width="18" Height="18" />
            <TextBlock Text="Import" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <ContentControl Content="{Binding ContentAcquisition}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="desktop:ContentAcquisitionViewModel">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="14,4,8,12" IsEnabled="{Binding IsInteractionEnabled}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Import" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Working…" IsVisible="{Binding IsBusy}" Classes="secondary" VerticalAlignment="Center" />
                  </Grid>

                  <Grid ColumnDefinitions="360,*" ColumnSpacing="16">
                    <StackPanel Spacing="7">
                      <TextBlock Text="Generate learning content" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="Topic or learning purpose" Classes="secondary" />
                      <TextBox Text="{Binding Subject}" Watermark="What do you want to learn?" />
                      <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <StackPanel>
                          <TextBlock Text="Items" Classes="secondary" />
                          <NumericUpDown Value="{Binding RequestedItemCount}" Minimum="1" Maximum="10000" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="Target Deck" Classes="secondary" />
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton Content="New" GroupName="ImportTarget" IsChecked="{Binding UseNewDeck}" />
                            <RadioButton Content="Existing" GroupName="ImportTarget" IsChecked="{Binding UseExistingDeck}" IsEnabled="{Binding HasExistingDecks}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <TextBox Text="{Binding NewDeckName}" Watermark="New Deck name" IsEnabled="{Binding UseNewDeck}" />
                      <ComboBox ItemsSource="{Binding ExistingDecks}" SelectedItem="{Binding SelectedExistingDeck}" IsEnabled="{Binding UseExistingDeck}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="desktop:DeckPresentationItem"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Text="Optional guidance" Classes="secondary" />
                      <TextBox Text="{Binding Guidance}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" />
                      <Button Content="Generate Prompt" Command="{Binding GeneratePromptCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="7">
                      <TextBlock Text="Generated prompt" FontSize="16" FontWeight="SemiBold" />
                      <TextBox Grid.Row="1" Text="{Binding GeneratedPrompt}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                               FontFamily="Consolas" FontSize="12" Height="250" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                      <Button Grid.Row="2" Content="Copy Prompt" Command="{Binding CopyPromptCommand}" HorizontalAlignment="Left" />
                    </Grid>
                  </Grid>

                  <Border BorderBrush="#22000000" BorderThickness="0,1,0,0" Margin="0,2,0,0" />
                  <TextBlock Text="Import Content Bundle" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="Drop one .json file here, or use the file picker / paste below." Classes="secondary" />
                  <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
                    <Grid RowDefinitions="*,Auto" RowSpacing="7">
                      <TextBox DragDrop.AllowDrop="True" DragDrop.Drop="OnBundleDrop" Text="{Binding RawJson}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                               Watermark="Paste Content Bundle 1.0 JSON" Height="300" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Load JSON File" Command="{Binding LoadJsonFileCommand}" />
                        <Button Content="Validate" Command="{Binding ValidateCommand}" />
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,*" RowSpacing="6">
                      <TextBlock Text="Bundle diagnostics" FontWeight="SemiBold" />
                      <ListBox Grid.Row="1" ItemsSource="{Binding BundleDiagnostics}" MaxHeight="105" IsHitTestVisible="False">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="desktop:AcquisitionDiagnosticDisplay">
                            <StackPanel Margin="2,3">
                              <TextBlock Text="{Binding Scope}" FontWeight="SemiBold" FontSize="11" />
                              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#D14B42" FontSize="12" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Button Grid.Row="2" Content="Generate Repair Prompt" Command="{Binding GenerateRepairPromptCommand}" HorizontalAlignment="Left" />
                      <Button Grid.Row="3" Content="Copy Repair Prompt" Command="{Binding CopyRepairPromptCommand}" HorizontalAlignment="Left" />
                      <TextBox Grid.Row="4" Text="{Binding RepairPrompt}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                               IsVisible="{Binding HasRepairPrompt}" FontSize="12" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                  </Grid>

                  <StackPanel Spacing="8" IsVisible="{Binding HasCurrentPreview}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding PreviewSummary, FallbackValue='Content preview'}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Select all valid" Command="{Binding SelectAllValidCommand}" />
                        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="Learning Items and Decks" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding PrimaryOperations}" Height="300">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="desktop:ContentOperationRowViewModel">
                          <Grid ColumnDefinitions="34,38,150,*" Margin="2,4" ColumnSpacing="7">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding OperationNumber}" Classes="secondary" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding OperationType}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="3" Spacing="2">
                              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" />
                              <TextBlock Text="{Binding Dependencies}" IsVisible="{Binding HasDependencies}" Classes="secondary" />
                              <TextBlock Text="{Binding Warnings}" IsVisible="{Binding HasWarnings}" Foreground="#B77900" TextWrapping="Wrap" FontSize="12" />
                              <TextBlock Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" Foreground="#D14B42" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Spacing="5" IsVisible="{Binding HasTechnicalOperations}">
                      <Button Content="{Binding TechnicalOperationsToggleText}" Command="{Binding ToggleTechnicalOperationsCommand}" HorizontalAlignment="Left" />
                      <ListBox ItemsSource="{Binding VisibleTechnicalOperations}" MaxHeight="180" IsVisible="{Binding HasVisibleTechnicalOperations}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="desktop:ContentOperationRowViewModel">
                            <Grid ColumnDefinitions="34,38,150,*" Margin="2,4" ColumnSpacing="7">
                              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top" />
                              <TextBlock Grid.Column="1" Text="{Binding OperationNumber}" Classes="secondary" />
                              <TextBlock Grid.Column="2" Text="{Binding OperationType}" FontWeight="SemiBold" FontSize="12" />
                              <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Dependencies}" IsVisible="{Binding HasDependencies}" Classes="secondary" />
                                <TextBlock Text="{Binding Warnings}" IsVisible="{Binding HasWarnings}" Foreground="#B77900" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" Foreground="#D14B42" TextWrapping="Wrap" FontSize="12" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                    <Button Content="Import Selected" Command="{Binding ImportSelectedCommand}" HorizontalAlignment="Left" />
                  </StackPanel>

                  <Border IsVisible="{Binding HasCurrentPreview}" BorderBrush="#22000000" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Pre-import Quality Review" FontSize="16" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="Auto,180,Auto,*" ColumnSpacing="8">
                        <TextBlock Text="Mode" VerticalAlignment="Center" Classes="secondary" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding QualityReviewModes}" SelectedItem="{Binding QualityReviewMode}" />
                        <Button Grid.Column="2" Content="Generate Quality Review Prompt" Command="{Binding GenerateQualityReviewPromptCommand}" />
                        <Button Grid.Column="3" Content="Copy Prompt" Command="{Binding CopyQualityReviewPromptCommand}" HorizontalAlignment="Left" />
                      </Grid>
                      <TextBox Text="{Binding QualityReviewPrompt}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                               Height="180" FontFamily="Consolas" FontSize="12" IsVisible="{Binding HasQualityReviewPrompt}"
                               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                      <TextBlock Text="Paste or load the Quality Review Result JSON" Classes="secondary" />
                      <TextBox Text="{Binding RawQualityReviewJson}" AcceptsReturn="True" TextWrapping="NoWrap" Height="180"
                               FontFamily="Consolas" FontSize="12" Watermark="Paste Quality Review Result JSON"
                               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Load Review JSON" Command="{Binding LoadQualityReviewFileCommand}" />
                        <Button Content="Preview Review Results" Command="{Binding PreviewQualityReviewCommand}" />
                        <Button Content="Select all valid reviews" Command="{Binding SelectAllValidQualityReviewsCommand}" />
                        <Button Content="Clear review selection" Command="{Binding ClearQualityReviewSelectionCommand}" />
                      </StackPanel>
                      <TextBlock Text="{Binding QualityReviewSummary}" FontWeight="SemiBold" IsVisible="{Binding HasQualityReviewPreview}" />
                      <ListBox ItemsSource="{Binding QualityReviewDiagnostics}" MaxHeight="100" IsVisible="{Binding HasQualityReviewPreview}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="desktop:CurationDiagnosticDisplay">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Text="{Binding Scope}" Classes="secondary" />
                              <TextBlock Text="{Binding Message}" Foreground="#D14B42" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <ListBox ItemsSource="{Binding QualityReviewResults}" Height="300" IsVisible="{Binding HasQualityReviewPreview}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="desktop:QualityReviewResultRowViewModel">
                            <Grid ColumnDefinitions="34,120,*,Auto" Margin="2,5" ColumnSpacing="7">
                              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top" />
                              <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontWeight="SemiBold" Foreground="#B77900" />
                              <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding SuggestedCorrection, StringFormat='Suggested correction: {0}'}" IsVisible="{Binding HasSuggestedCorrection}" Foreground="#7A5A00" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" Foreground="#D14B42" TextWrapping="Wrap" FontSize="12" />
                              </StackPanel>
                              <TextBlock Grid.Column="3" Text="{Binding LocalRef}" Classes="secondary" VerticalAlignment="Top" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding HasImportResult}" Background="#10008000" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Import complete" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ImportResult}" TextWrapping="Wrap" />
                      <Button Content="{Binding ImportedDetailsToggleText}" Command="{Binding ToggleImportedDetailsCommand}" HorizontalAlignment="Left" />
                      <ListBox ItemsSource="{Binding Operations}" MaxHeight="180" IsVisible="{Binding ShowImportedDetails}" IsHitTestVisible="False">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="desktop:ContentOperationRowViewModel">
                            <Grid ColumnDefinitions="38,150,*" Margin="2,3" ColumnSpacing="7">
                              <TextBlock Text="{Binding OperationNumber}" Classes="secondary" />
                              <TextBlock Grid.Column="1" Text="{Binding OperationType}" FontWeight="SemiBold" FontSize="12" />
                              <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#14000000" CornerRadius="4" Padding="10,7">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
