<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Illumination.Desktop"
             xmlns:content="using:Illumination.Application.ContentManagement"
             x:Class="Illumination.Desktop.DecksView"
             x:DataType="desktop:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="12">
      <TextBlock Text="Decks" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Choose what you want to learn, start Study or read-only Practice, and keep Deck membership organized. Destructive and learning-state maintenance actions stay out of the normal path." Classes="secondary" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="300,*" ColumnSpacing="20">
        <StackPanel Spacing="10">
          <TextBlock Text="Your Decks" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding DeckPresentationItems}" SelectedItem="{Binding SelectedDeckPresentation}" MinHeight="300">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="desktop:DeckPresentationItem">
                <StackPanel Margin="6">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding LearningItemCount, StringFormat='{}{0} card(s)'}" Opacity="0.65" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Expander Header="Create a Deck" IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,5,0,0">
              <TextBlock Text="A Deck groups cards for Study. A card may belong to more than one Deck while keeping one shared Learning State." Classes="secondary" TextWrapping="Wrap" />
              <TextBox Text="{Binding NewDeckName}" Watermark="Deck name" />
              <Button Content="Create Deck" Command="{Binding CreateDeckCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>

          <Border Classes="surface" Padding="10">
            <StackPanel Spacing="7">
              <TextBlock Text="Use selected Deck" FontWeight="SemiBold" />
              <TextBlock Text="Study follows the scheduler. Practice now ignores due dates and never writes Reviews or scheduling changes." Classes="secondary" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Button Content="Study selected" Command="{Binding PrepareSelectedDeckStudyCommand}" />
                <Button Content="Practice now" Command="{Binding StartSelectedDeckPracticeCommand}" />
              </WrapPanel>
              <Button Content="Generate learning-aware follow-up" Command="{Binding GenerateFollowUpFromSelectedDeckCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Expander Header="Study across Decks" IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,5,0,0">
              <TextBlock Text="Prepare one Study Session using the union of all current Decks. Shared cards are deduplicated." Classes="secondary" TextWrapping="Wrap" />
              <Button Content="Study all Decks" Command="{Binding PrepareAllDecksStudyCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>

          <Border Classes="surface" IsVisible="{Binding PracticeIsActive}" Padding="9">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Practice now" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding PracticeProgress}" Classes="secondary" />
              </Grid>
              <TextBlock Text="{Binding CurrentPracticeItem.Prompt}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Border Background="#0C008000" CornerRadius="5" Padding="7" IsVisible="{Binding PracticeSolutionRevealed}">
                <TextBlock Text="{Binding CurrentPracticeItem.ReferenceSolution}" TextWrapping="Wrap" />
              </Border>
              <Button Content="Reveal reference answer" Command="{Binding RevealPracticeSolutionCommand}" IsVisible="{Binding !PracticeSolutionRevealed}" HorizontalAlignment="Left" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
                <Button Content="Previous" Command="{Binding PreviousPracticeItemCommand}" />
                <Button Content="Next" Command="{Binding NextPracticeItemCommand}" />
                <Button Content="Close" Command="{Binding ClosePracticeCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Expander Header="Manage selected Deck" IsExpanded="False">
            <StackPanel Spacing="8" Margin="0,5,0,0">
              <TextBlock Text="Rename, export or delete the selected Deck. Deleting a Deck removes only the Deck and memberships; its cards, Reviews and Learning State remain." Classes="secondary" TextWrapping="Wrap" />
              <TextBox Text="{Binding RenameDeckName}" Watermark="New Deck name" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Button Content="Rename" Command="{Binding RenameDeckCommand}" />
                <Button Content="Delete Deck" Command="{Binding DeleteSelectedDeckCommand}" />
              </WrapPanel>
              <TextBlock Text="Portable content" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock Text="Content Bundle export contains the Deck and its cards. Learning progress and Review history stay in the local database." Classes="secondary" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Button Content="Export bundle..." Command="{Binding ExportSelectedDeckBundleCommand}" />
                <Button Content="Copy bundle JSON" Command="{Binding CopySelectedDeckBundleCommand}" />
              </WrapPanel>
            </StackPanel>
          </Expander>

          <Expander Header="Advanced: learning-state maintenance" IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,5,0,0">
              <TextBlock Text="Restart learning changes real scheduling state for the selected Deck. It keeps content, membership and immutable Review history, but makes eligible cards new and due now. Use Practice now instead when you only want to look through material again." TextWrapping="Wrap" Classes="secondary" />
              <TextBlock Text="The restart action requires a second click to confirm." TextWrapping="Wrap" Classes="secondary" />
              <Button Content="Restart Deck learning" Command="{Binding RestartSelectedDeckLearningCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Text="Cards in selected Deck" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Select a card below to practice it immediately or use the maintenance controls. Deck membership changes do not delete cards from the Library." Classes="secondary" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding SelectedDeckItems}" SelectedItem="{Binding SelectedDeckItem}" MinHeight="280">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="content:LearningItemView">
                <StackPanel Margin="6" Spacing="2">
                  <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ResponseMode}" Classes="secondary" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button Content="Practice selected card" Command="{Binding StartSelectedItemPracticeCommand}" />
          </WrapPanel>

          <Expander Header="Manage cards in this Deck" IsExpanded="False">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,6,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="Remove from Deck" FontWeight="SemiBold" />
                <TextBlock Text="Removes only this membership. The card and its Learning State remain available elsewhere." Classes="secondary" TextWrapping="Wrap" />
                <Button Content="Remove selected card" Command="{Binding RemoveFromDeckCommand}" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Add existing Library card" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding AvailableDeckItems}" SelectedItem="{Binding SelectedAvailableDeckItem}" MaxHeight="260">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="content:LearningItemView">
                      <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="6" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Add selected card" Command="{Binding AddToDeckCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Expander>

          <Expander Header="Advanced: selected-card learning state" IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,5,0,0">
              <TextBlock Text="Restart only the selected card's current scheduling state. Review history is preserved." Classes="secondary" TextWrapping="Wrap" />
              <Button Content="Restart selected card" Command="{Binding RestartSelectedDeckItemLearningCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
