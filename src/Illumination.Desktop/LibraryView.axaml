<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Illumination.Desktop"
             xmlns:content="using:Illumination.Application.ContentManagement"
             x:Class="Illumination.Desktop.LibraryView"
             x:DataType="desktop:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="*,360" ColumnSpacing="24" Margin="12">
      <StackPanel Spacing="8">
        <StackPanel Spacing="3">
          <TextBlock Text="Learning Items" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Find and edit individual cards here. Bulk curation and Quality Review tools are available below when you need them." Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox Text="{Binding ContentCuration.SearchText}" PlaceholderText="Search questions / tasks" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <ComboBox Width="170" ItemsSource="{Binding DeckPresentationItems}" SelectedItem="{Binding ContentCuration.FilterDeckPresentation}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="desktop:DeckPresentationItem"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="125" ItemsSource="{Binding ContentCuration.LifecycleFilters}" SelectedItem="{Binding ContentCuration.FilterLifecycle}" />
          <ComboBox Width="125" ItemsSource="{Binding ContentCuration.ResponseModeFilters}" SelectedItem="{Binding ContentCuration.FilterResponseMode}" />
          <Button Content="Clear filters" Command="{Binding ContentCuration.ClearLibraryFiltersCommand}" />
        </WrapPanel>
        <Grid ColumnDefinitions="44,58,*" Margin="6,0,6,0">
          <TextBlock Text="Bulk" Classes="secondary" />
          <TextBlock Grid.Column="1" Text="Review" Classes="secondary" />
          <TextBlock Grid.Column="2" Text="Content" Classes="secondary" />
        </Grid>
        <ListBox ItemsSource="{Binding ContentCuration.FilteredItems}" SelectedItem="{Binding ContentCuration.SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="desktop:CuratedLearningItemRowViewModel">
              <Grid ColumnDefinitions="34,48,*,Auto" Margin="6" ColumnSpacing="7">
                <CheckBox IsChecked="{Binding IsSelectedForManagement}" VerticalAlignment="Top" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelectedForReview}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="{Binding Prompt}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding QualityState}" Foreground="#B77900" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding ContentRevision, StringFormat='rev {0}'}" Classes="secondary" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Expander Header="Bulk manage" IsExpanded="False">
          <StackPanel Spacing="8" Margin="0,5,0,0">
            <TextBlock Text="Use the Bulk checkbox to select several Learning Items. This is separate from the Review checkbox used by Quality Review." TextWrapping="Wrap" Classes="secondary" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button Content="Select filtered" Command="{Binding ContentCuration.SelectFilteredForManagementCommand}" />
              <Button Content="Clear bulk selection" Command="{Binding ContentCuration.ClearManagementSelectionCommand}" />
            </WrapPanel>

            <TextBlock Text="Build a Deck from the selection" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding ContentCuration.BulkNewDeckName}" PlaceholderText="New Deck name" />
              <Button Grid.Column="1" Content="Create Deck" Command="{Binding ContentCuration.CreateDeckFromSelectedCommand}" />
            </Grid>

            <TextBlock Text="Existing Deck membership" FontWeight="SemiBold" />
            <ComboBox Width="220" ItemsSource="{Binding DeckPresentationItems}" SelectedItem="{Binding ContentCuration.BulkTargetDeckPresentation}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="desktop:DeckPresentationItem"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button Content="Add to Deck" Command="{Binding ContentCuration.BulkAddSelectedToDeckCommand}" />
              <Button Content="Remove from Deck" Command="{Binding ContentCuration.BulkRemoveSelectedFromDeckCommand}" />
            </WrapPanel>

            <TextBlock Text="Flags" FontWeight="SemiBold" />
            <ComboBox Width="220" ItemsSource="{Binding ContentCuration.FlagDefinitions}" SelectedItem="{Binding ContentCuration.BulkTargetFlag}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="content:UserFlagDefinitionView"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button Content="Add flag" Command="{Binding ContentCuration.BulkAddFlagCommand}" />
              <Button Content="Remove flag" Command="{Binding ContentCuration.BulkRemoveFlagCommand}" />
            </WrapPanel>

            <TextBlock Text="Lifecycle" FontWeight="SemiBold" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button Content="Suspend" Command="{Binding ContentCuration.BulkSuspendSelectedCommand}" />
              <Button Content="Reactivate" Command="{Binding ContentCuration.BulkReactivateSelectedCommand}" />
              <Button Content="Mark mastered" Command="{Binding ContentCuration.BulkMarkMasteredSelectedCommand}" />
              <Button Content="Unmark mastered" Command="{Binding ContentCuration.BulkUnmarkMasteredSelectedCommand}" />
            </WrapPanel>

            <TextBlock Text="Improve selected content with ChatGPT" FontWeight="SemiBold" />
            <TextBlock Text="Generates update_learning_item operations only. Returned JSON still goes through normal Generate / Import preview and explicit selection." TextWrapping="Wrap" Classes="secondary" />
            <ComboBox Width="150" ItemsSource="{Binding ContentCuration.ImprovementSignificanceOptions}" SelectedItem="{Binding ContentCuration.ImprovementSignificance}" />
            <TextBox Text="{Binding ContentCuration.ImprovementGuidance}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" PlaceholderText="What should be improved? e.g. natural language, factual precision, clearer distractors..." />
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button Content="Generate update prompt" Command="{Binding ContentCuration.GenerateImprovementPromptCommand}" />
              <Button Content="Copy update prompt" Command="{Binding ContentCuration.CopyImprovementPromptCommand}" IsEnabled="{Binding ContentCuration.HasImprovementPrompt}" />
            </WrapPanel>
            <TextBox Text="{Binding ContentCuration.ImprovementPrompt}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="130" IsVisible="{Binding ContentCuration.HasImprovementPrompt}" FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </StackPanel>
        </Expander>

        <Expander Header="Advanced: Review selection and quality filter" IsExpanded="False">
          <StackPanel Spacing="7" Margin="0,5,0,0">
            <TextBlock Text="The Review checkbox selects Learning Items for the optional Quality Review exchange. It does not change scheduling or Study progress." Classes="secondary" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
              <Button Content="Select all for review" Command="{Binding ContentCuration.SelectAllReviewItemsCommand}" />
              <Button Content="Clear review selection" Command="{Binding ContentCuration.ClearReviewItemSelectionCommand}" />
            </WrapPanel>
            <TextBlock Text="Filter by user flag" Classes="secondary" />
            <ComboBox ItemsSource="{Binding ContentCuration.FlagDefinitions}" SelectedItem="{Binding ContentCuration.FilterFlag}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="content:UserFlagDefinitionView"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Expander>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="8">
        <TextBlock Text="{Binding Editor.FormTitle}" FontSize="18" FontWeight="SemiBold" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <Button Content="New" Command="{Binding Editor.NewCommand}" />
          <Button Content="Save" Command="{Binding Editor.SaveCommand}" />
          <Button Content="Cancel" Command="{Binding Editor.CancelCommand}" />
        </WrapPanel>
        <Border IsVisible="{Binding Editor.HasAdvisorySuggestion}" BorderBrush="#55B77900" BorderThickness="1" CornerRadius="6" Padding="9">
          <StackPanel Spacing="5">
            <TextBlock Text="Quality Review suggestion" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Editor.AdvisorySuggestion}" TextWrapping="Wrap" />
            <TextBlock Text="Advisory only — change the actual fields below, then save normally." Classes="secondary" TextWrapping="Wrap" />
            <Button Content="Dismiss suggestion" Command="{Binding Editor.DismissAdvisorySuggestionCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <TextBlock Text="Question / task" FontWeight="SemiBold" />
        <TextBlock Text="This is what appears on the front of the Learning Item during Study. It is not a ChatGPT prompt." Classes="secondary" TextWrapping="Wrap" />
        <TextBox Text="{Binding Editor.Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" PlaceholderText="What should the learner answer or do?" />
        <TextBlock Text="Reference answer" FontWeight="SemiBold" />
        <TextBlock Text="The answer or solution shown for checking the Learning Item." Classes="secondary" TextWrapping="Wrap" />
        <TextBox Text="{Binding Editor.ReferenceSolution}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" PlaceholderText="Expected answer or solution" />
        <StackPanel Spacing="4" IsVisible="{Binding Editor.IsCreating}">
          <TextBlock Text="Add to Deck (optional)" Classes="secondary" />
          <ComboBox ItemsSource="{Binding DeckPresentationItems}" SelectedItem="{Binding Editor.SelectedDeckPresentation}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="desktop:DeckPresentationItem"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Leave empty to create an unassigned Learning Item." Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="surface" Padding="9">
          <StackPanel Spacing="5">
            <TextBlock Text="Need more than one card?" FontWeight="SemiBold" />
            <TextBlock Text="Use Generate / Import to create or extend a Deck with ChatGPT and bring the returned Content Bundle back by paste, file picker, or drag &amp; drop." Classes="secondary" TextWrapping="Wrap" />
            <Button Content="Open Generate / Import" Command="{Binding NavigateImportCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
          <TextBlock Text="Response mode" VerticalAlignment="Center" />
          <ComboBox Width="150" ItemsSource="{Binding Editor.ResponseModes}" SelectedItem="{Binding Editor.ResponseMode}" />
          <CheckBox Content="Suitable for low-interaction study" IsChecked="{Binding Editor.LowInteractionEligible}" />
        </WrapPanel>
        <TextBlock Text="Response mode controls how an answer is entered or checked. Low-interaction suitability only affects optional Study filtering." Classes="secondary" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Editor.ValidationMessage}" Foreground="#D14B42" TextWrapping="Wrap" />

        <Expander Header="Hints" IsExpanded="False">
          <StackPanel Spacing="4">
            <ItemsControl ItemsSource="{Binding Editor.Hints}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:EditorHintRow">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBox Text="{Binding Text}" />
                    <Button Grid.Column="1" Content="↑" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveHintUpCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="↓" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveHintDownCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Content="Remove" Command="{Binding $parent[ItemsControl].DataContext.Editor.RemoveHintCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add hint" Command="{Binding Editor.AddHintCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>

        <Expander Header="Selection choices" IsVisible="{Binding Editor.IsSelection}" IsExpanded="True">
          <StackPanel Spacing="4">
            <ItemsControl ItemsSource="{Binding Editor.DirectChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:EditorChoiceRow">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBox Text="{Binding Text}" />
                    <CheckBox Grid.Column="1" Content="Correct" IsChecked="{Binding IsCorrect}" />
                    <Button Grid.Column="2" Content="↑" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveDirectChoiceUpCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Content="↓" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveDirectChoiceDownCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="4" Content="Remove" Command="{Binding $parent[ItemsControl].DataContext.Editor.RemoveDirectChoiceCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add choice" Command="{Binding Editor.AddDirectChoiceCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>

        <Expander Header="Accepted short answers" IsVisible="{Binding Editor.IsShortText}" IsExpanded="True">
          <StackPanel Spacing="4">
            <ItemsControl ItemsSource="{Binding Editor.AcceptedAnswers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:EditorTextRow">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBox Text="{Binding Text}" />
                    <Button Grid.Column="1" Content="↑" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveAcceptedAnswerUpCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="↓" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveAcceptedAnswerDownCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Content="Remove" Command="{Binding $parent[ItemsControl].DataContext.Editor.RemoveAcceptedAnswerCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add accepted answer" Command="{Binding Editor.AddAcceptedAnswerCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>

        <Expander Header="Assistance choices" IsExpanded="False">
          <StackPanel Spacing="4">
            <ItemsControl ItemsSource="{Binding Editor.AssistanceChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:EditorChoiceRow">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBox Text="{Binding Text}" />
                    <Button Grid.Column="1" Content="↑" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveAssistanceChoiceUpCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="↓" Command="{Binding $parent[ItemsControl].DataContext.Editor.MoveAssistanceChoiceDownCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Content="Remove" Command="{Binding $parent[ItemsControl].DataContext.Editor.RemoveAssistanceChoiceCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add assistance choice" Command="{Binding Editor.AddAssistanceChoiceCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>

        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <Button Content="Edit selected item" Command="{Binding EditSelectedItemCommand}" />
          <Button Content="Delete permanently" Command="{Binding DeleteSelectedLearningItemCommand}" />
        </WrapPanel>

        <TextBlock Text="Selected item" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ContentCuration.SelectedItem.Lifecycle, StringFormat='Lifecycle: {0}', FallbackValue='Select an item to manage its lifecycle.'}" Classes="secondary" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <Button Content="Suspend" Command="{Binding ContentCuration.SuspendSelectedCommand}" IsVisible="{Binding ContentCuration.CanSuspendSelected}" />
          <Button Content="Reactivate" Command="{Binding ContentCuration.ReactivateSelectedCommand}" IsVisible="{Binding ContentCuration.CanReactivateSelected}" />
          <Button Content="Mark mastered" Command="{Binding ContentCuration.MarkMasteredSelectedCommand}" IsVisible="{Binding ContentCuration.CanMarkMasteredSelected}" />
          <Button Content="Unmark mastered" Command="{Binding ContentCuration.UnmarkMasteredSelectedCommand}" IsVisible="{Binding ContentCuration.CanUnmarkMasteredSelected}" />
        </WrapPanel>
        <Expander Header="Advanced: quality, flags and review exchange" IsExpanded="False">
          <StackPanel Spacing="8" Margin="0,5,0,0">
            <TextBlock Text="Specialist curation metadata. These tools do not replace normal Learning Item editing or scheduled Study." Classes="secondary" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ContentCuration.SelectedItem.QualityState, FallbackValue='Select an item'}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ContentCuration.SelectedItem.ContentRevision, StringFormat='ContentRevision: {0}'}" Classes="secondary" />

            <TextBlock Text="User flags" FontWeight="SemiBold" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
              <ComboBox Width="180" ItemsSource="{Binding ContentCuration.FlagDefinitions}" SelectedItem="{Binding ContentCuration.SelectedFlag}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="content:UserFlagDefinitionView"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Add flag" Command="{Binding ContentCuration.AddFlagCommand}" />
              <Button Content="Remove flag" Command="{Binding ContentCuration.RemoveFlagCommand}" />
            </WrapPanel>
            <TextBlock Text="Create a user-defined flag" Classes="secondary" />
            <TextBox Text="{Binding ContentCuration.NewFlagName}" PlaceholderText="Flag name" />
            <TextBox Text="{Binding ContentCuration.NewFlagMeaning}" PlaceholderText="What does this flag mean?" />
            <Button Content="Create flag" Command="{Binding ContentCuration.CreateFlagCommand}" HorizontalAlignment="Left" />

            <TextBlock Text="Quality Review history" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding ContentCuration.SelectedItem.History}" MaxHeight="140">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="desktop:QualityReviewHistoryRowViewModel">
                  <StackPanel Margin="2,3" Spacing="2">
                    <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding SuggestedCorrection}" TextWrapping="Wrap" FontSize="12" Foreground="#B77900" />
                    <TextBlock Text="Active" IsVisible="{Binding IsActive}" Classes="secondary" />
                    <TextBlock Text="Superseded historical review" IsVisible="{Binding !IsActive}" Classes="secondary" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Quality Review exchange" FontWeight="SemiBold" />
            <TextBlock Text="Optional ChatGPT-based review workflow. Generate a review prompt, then paste or load its structured result before explicitly accepting reviews." Classes="secondary" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
              <ComboBox Width="150" ItemsSource="{Binding ContentCuration.ReviewModes}" SelectedItem="{Binding ContentCuration.ReviewMode}" />
              <Button Content="Generate review prompt" Command="{Binding ContentCuration.GenerateReviewPromptCommand}" />
              <Button Content="Copy review prompt" Command="{Binding ContentCuration.CopyReviewPromptCommand}" />
            </WrapPanel>
            <TextBox Text="{Binding ContentCuration.ReviewPrompt}" IsReadOnly="True" AcceptsReturn="True" Height="120" IsVisible="{Binding ContentCuration.HasReviewPrompt}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBox Text="{Binding ContentCuration.RawReviewJson}" AcceptsReturn="True" Height="130" PlaceholderText="Paste Quality Review Result JSON" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
              <Button Content="Load result" Command="{Binding ContentCuration.LoadReviewFileCommand}" />
              <Button Content="Preview result" Command="{Binding ContentCuration.PreviewReviewResultsCommand}" />
              <Button Content="Accept selected reviews" Command="{Binding ContentCuration.AcceptSelectedReviewsCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding ContentCuration.ReviewSummary}" IsVisible="{Binding ContentCuration.HasReviewPreview}" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding ContentCuration.ReviewResults}" Height="190" IsVisible="{Binding ContentCuration.HasReviewPreview}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="desktop:QualityReviewExchangeRowViewModel">
                  <StackPanel Margin="2,3" Spacing="2">
                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" Content="{Binding Outcome}" />
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding SuggestedCorrection, StringFormat='Suggested correction: {0}'}" IsVisible="{Binding HasSuggestedCorrection}" Foreground="#B77900" TextWrapping="Wrap" FontSize="12" />
                    <Button Content="Edit using suggestion" IsVisible="{Binding HasSuggestedCorrection}" Command="{Binding $parent[ListBox].DataContext.EditFromPreviewSuggestionCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" Foreground="#D14B42" TextWrapping="Wrap" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding PriorActiveReviews}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="desktop:QualityReviewHistoryRowViewModel">
                          <CheckBox Content="{Binding Findings, StringFormat='Supersede: {0}'}" Command="{Binding $parent[ItemsControl].DataContext.ToggleSupersededCommand}" CommandParameter="{Binding Id}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>