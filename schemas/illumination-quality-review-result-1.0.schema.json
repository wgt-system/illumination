{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://illumination.local/schemas/quality-review-result-1.0.schema.json",
  "title": "Illumination Quality Review Result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "results"],
  "properties": {
    "contract": { "const": "illumination.quality-review-result" },
    "version": { "const": "1.0" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learningItemId", "contentRevision", "outcome", "evidenceType", "findings"],
      "properties": {
        "learningItemId": { "$ref": "#/$defs/stableId" },
        "contentRevision": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["pass", "warning", "needs_review"] },
        "evidenceType": { "enum": ["model_review", "source_grounded_review", "user_review"] },
        "findings": { "type": "string", "minLength": 1 },
        "suggestedCorrection": { "type": "string", "minLength": 1 }
      }
    }
  }
}
